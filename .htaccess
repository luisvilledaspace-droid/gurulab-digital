# Página de error personalizada
ErrorDocument 404 /404.html

RewriteEngine On

# El certificado SSL del hosting cubre gurulab.digital pero NO www.gurulab.digital,
# así que la dirección oficial es la del dominio sin www. Si algún día el
# certificado llega a cubrir ambos, se puede invertir esta regla.
RewriteCond %{HTTP_HOST} ^www\.gurulab\.digital$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ %{REQUEST_SCHEME}://gurulab.digital%{REQUEST_URI} [L,R=301]

# Todo el tráfico va cifrado
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://gurulab.digital%{REQUEST_URI} [L,R=301]

# Caché del navegador para recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# No exponer archivos del repositorio si alguna vez se copian por error
<FilesMatch "^(\.cpanel\.yml|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>
