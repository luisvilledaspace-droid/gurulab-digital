# Página de error personalizada
ErrorDocument 404 /404.html

RewriteEngine On

# Redirigir gurulab.digital -> www.gurulab.digital conservando el esquema
# (http sigue en http, https sigue en https). Excluye .well-known para que
# AutoSSL pueda validar el dominio sin www al emitir el certificado.
RewriteCond %{HTTP_HOST} ^gurulab\.digital$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ %{REQUEST_SCHEME}://www.gurulab.digital%{REQUEST_URI} [L,R=301]

# Forzar HTTPS. Descomenta estas dos líneas cuando el certificado SSL
# del dominio esté emitido (cPanel > SSL/TLS Status > AutoSSL).
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://www.gurulab.digital%{REQUEST_URI} [L,R=301]

# Caché del navegador para recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# No exponer archivos del repositorio si alguna vez se copian por error
<FilesMatch "^(\.cpanel\.yml|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>
